# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Machine-specific — contains local SDK paths
**/local.properties
.flutter-plugins

# Leftover Android scaffolding, replaced by android/
/android_old/
/android_old_manifest.txt

# Emulator/device captures and scratch output
/screenshots/

